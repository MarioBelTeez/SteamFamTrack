# Discord Bot Credentials (from Discord Developer Portal)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set for instant guild-only command registration during development
DISCORD_GUILD_ID=

# SteamFamTrack Next.js API base URL
STEAMFAM_API_URL=http://localhost:3000

# Shared HMAC secret matching the web app's DISCORD_LINK_SECRET (for verified Steam OpenID /link)
DISCORD_LINK_SECRET=

# Supabase (for steamfam.discord_links and family lookups)
SUPABASE_URL=https://your-supabase-instance.example.com
SUPABASE_SERVICE_ROLE_KEY=
