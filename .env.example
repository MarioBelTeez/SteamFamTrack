# Required: Live Steam Web API profile & library lookups.
# Get a key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Optional: Self-hosted or cloud Supabase (uses isolated `steamfam` schema).
# Enables private account-based families, persistent 7-day price cache,
# weekly/monthly snapshot history, and Discord bot linking.
SUPABASE_URL=https://your-supabase-instance.example.com
SUPABASE_SERVICE_ROLE_KEY=

# Required for Steam OpenID 2.0 sessions (generate a random 32+ char secret)
SESSION_SECRET=

# Optional: Shared HMAC secret between the web app and Discord bot for verified /link
DISCORD_LINK_SECRET=

# Optional: Bearer token protecting POST /api/cron/snapshots
CRON_SECRET=

# Optional: Canonical public site URL (used for OpenID return URL, OG tags, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://steamft.com

# Optional: Discord Activity OAuth2 bridge (for running SteamFamTrack inside Discord)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NEXT_PUBLIC_DISCORD_CLIENT_ID=

# Optional: Community links shown in the dashboard
NEXT_PUBLIC_DISCORD_SERVER_URL=
NEXT_PUBLIC_STEAM_GROUP_URL=
NEXT_PUBLIC_BELTEEZ_STUDIO_URL=
