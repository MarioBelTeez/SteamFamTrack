# Required: Live Steam Web API profile & library lookups.
# Get a key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Optional: Self-hosted or cloud Supabase (uses isolated `steamfam` schema).
# Without these, the app still works in stateless mode; with them, it enables:
# - Shareable saved families (/f/<slug>) with edit passcode protection
# - Persistent Steam Store appdetails price cache (saves API rate limits)
# - Monthly contribution snapshots & delta history
SUPABASE_URL=http://192.168.1.211:8000
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Discord Activity OAuth2 bridge (for launching SteamFamTrack inside Discord VC/text channels)
DISCORD_CLIENT_ID=1575252351776989296
DISCORD_CLIENT_SECRET=
NEXT_PUBLIC_DISCORD_CLIENT_ID=1575252351776989296
NEXT_PUBLIC_DISCORD_SERVER_URL=https://discord.gg/3FBZdMJe8m
NEXT_PUBLIC_BELTEEZ_STUDIO_URL=https://belteez.studio
